{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "happy-helper": {
            "root": ".",
            "framework": "vite",
            "buildCommand": "npm install && npm run build"
        },
        "backend": {
            "root": "backend",
            "framework": "express"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "happy-helper"
            }
        }
    ]
}